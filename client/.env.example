# Sri Shakthi Vinayaga Metals - Client Environment Variables

# Backend API endpoint URL (use /api in local development with Vite proxy)
VITE_API_BASE_URL=/api

# Production canonical domain (used for canonical URLs, sitemaps, OpenGraph, JSON-LD)
VITE_SITE_URL=https://srishakthivinayagametals.com

# Optional Google Analytics 4 Measurement ID (leave empty or unset to disable)
VITE_GA_MEASUREMENT_ID=
